   "set": "toon",
   "params": {
    "u": 89
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s091",
   "start": 401.0,
   "end": 404.53,
   "line": "Il lavoro è meno fisico, ma più pesante da portare a casa.",
