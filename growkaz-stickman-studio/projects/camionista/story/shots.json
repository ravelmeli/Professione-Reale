   "set": "toon",
   "params": {
    "u": 62
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s064",
   "start": 286.89,
   "end": 290.98,
   "line": "Se manca un foglio, il camion resta fermo, e il tempo si perde.",
