   "params": {
    "u": 107
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s109",
   "start": 473.09,
   "end": 476.8,
   "line": "E qui cambia tutto da persona a persona, e da anno ad anno.",
