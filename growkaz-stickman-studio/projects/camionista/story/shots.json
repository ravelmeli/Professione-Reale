   "params": {
    "u": 73
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s075",
   "start": 331.86,
   "end": 334.92,
   "line": "Livello quattro. Capo traffico.",
