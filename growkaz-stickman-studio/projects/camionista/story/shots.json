   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s071",
   "start": 319.69,
   "end": 322.45,
   "line": "Il costo nascosto, però, lo conosciamo tutti.",
