    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s110",
   "start": 476.8,
   "end": 480.81,
   "line": "Se un cliente non paga, aspetti. E se non paga mai, ci rimetti.",
