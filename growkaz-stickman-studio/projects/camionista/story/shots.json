   "params": {
    "u": 68
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s070",
   "start": 312.08,
   "end": 319.69,
   "line": "Ma anche qui, la cifra dipende dal contratto, dalla tratta e dall'azienda. Non possiamo darti un numero, senza rischiare di inventarlo.",
