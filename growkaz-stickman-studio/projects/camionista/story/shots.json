   "params": {
    "u": 71
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s073",
   "start": 325.59,
   "end": 327.9,
   "line": "Sono i figli che crescono mentre tu guidi.",
