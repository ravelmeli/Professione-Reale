   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s093",
   "start": 408.11,
   "end": 411.71,
   "line": "Ma finalmente dormi nel tuo letto, e vedi i tuoi figli la sera.",
