    "u": 90
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s092",
   "start": 404.53,
   "end": 408.11,
   "line": "Una decisione sbagliata costa soldi, e a volte costa di peggio.",
