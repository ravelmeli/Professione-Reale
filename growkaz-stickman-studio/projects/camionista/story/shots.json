   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s069",
   "start": 308.54,
   "end": 312.08,
   "line": "Per questo chi ha più formazione, spesso, è pagato di più.",
   "scene": "unit 68",
