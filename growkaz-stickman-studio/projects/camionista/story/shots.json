    "u": 106
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s108",
   "start": 467.82,
   "end": 473.09,
   "line": "Il guadagno, quindi, non è lo stipendio: è quello che resta dopo tutte le spese.",
