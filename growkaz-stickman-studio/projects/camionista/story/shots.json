   "params": {
    "u": 61
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s063",
   "start": 281.15,
   "end": 286.89,
   "line": "I documenti diventano una parte del lavoro: lettere di vettura, permessi, dichiarazioni.",
