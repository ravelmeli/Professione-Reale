    "u": 104
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s106",
   "start": 457.25,
   "end": 463.75,
   "line": "I clienti pagano a trenta, sessanta, a volte novanta giorni. Questa è una pratica comune, non una regola fissa.",
   "scene": "unit 105",
   "set": "toon",
   "params": {
    "u": 105
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s107",
   "start": 463.75,
   "end": 467.82,
   "line": "Ma intanto il gasolio lo paghi subito, e la rata del camion arriva puntuale.",
