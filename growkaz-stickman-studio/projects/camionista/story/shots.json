   "scene": "unit 110",
   "set": "toon",
   "params": {
    "u": 110
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s112",
   "start": 484.47,
   "end": 489.26,
   "line": "È comodo, ma se quel cliente ti lascia, resti senza lavoro dall'oggi al domani.",
   "scene": "unit 111",
