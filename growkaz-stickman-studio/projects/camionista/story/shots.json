   "sfx": [
    {
     "at": 0.15,
     "name": "whoosh",
     "gain": -9
    }
   ]
  },
  {
   "id": "s076",
   "start": 334.92,
   "end": 337.96,
   "line": "Dopo anni di strada, qualcuno ti propone di scendere dal camion.",
   "scene": "unit 75",
   "set": "toon",
   "params": {
    "u": 75
   },
   "in": {
    "type": "cut",
    "dur": 0.3
   },
   "sfx": []
  },
  {
   "id": "s077",
   "start": 337.96,
   "end": 342.03,
   "line": "Ti siedi dietro una scrivania, e devi organizzare gli altri autisti.",
